#!/usr/bin/env bash
# farm-view <per> [session] — arrange the farm pool into tabs of <per> panes,
# as a clean even grid (per -> cols x rows: 4=2x2, 6=3x2, 8=4x2).
#   - idle tab (only shells)      -> rebuilt into an even grid
#   - tab with a running agent    -> panes regrouped (moved, never killed), tiled
per="${1:-8}"
sess="${2:-$(tmux display-message -p '#{session_name}' 2>/dev/null)}"
start_dir="${3:-$HOME/Projects}"     # new panes always open here, not a wandered cwd
[[ -n "$sess" ]] || { echo "farm-view: no session" >&2; exit 1; }

is_idle() {   # true if no pane in window $1 runs anything but a shell
  ! tmux list-panes -t "$1" -F '#{pane_current_command}' \
    | grep -qvE '^(zsh|-zsh|bash|-bash|sh|login)$'
}

even_grid() {   # rebuild idle window $1 into an even grid sized to ITS pane count
  local win="$1" pid i n c r
  n=$(tmux list-panes -t "$win" | wc -l | tr -d ' ')
  (( n < 2 )) && return
  if (( n >= 4 )); then r=2; else r=1; fi      # 2 rows once there are >=4 panes
  c=$(( (n + r - 1) / r ))                       # ceil(n/r) columns
  tmux list-panes -t "$win" -F '#{pane_id}' | tail -n +2 | while read -r pid; do
    tmux kill-pane -t "$pid" 2>/dev/null
  done
  for ((i = 1; i < c; i++)); do tmux split-window -h -t "$win" -c "$start_dir" 2>/dev/null; done
  tmux select-layout -t "$win" even-horizontal >/dev/null 2>&1
  while read -r pid; do
    for ((i = 1; i < r; i++)); do tmux split-window -v -t "$pid" -c "$start_dir" 2>/dev/null; done
  done < <(tmux list-panes -t "$win" -F '#{pane_id}')
}

# 1) consolidate every pane into the first window (rebalance so splits fit)
first=$(tmux list-windows -t "$sess" -F '#{window_id}' | head -1)
for pid in $(tmux list-panes -s -t "$sess" -F '#{pane_id}'); do
  [[ "$(tmux display-message -p -t "$pid" '#{window_id}')" == "$first" ]] && continue
  tmux join-pane -d -s "$pid" -t "$first" 2>/dev/null
  tmux select-layout -t "$first" tiled >/dev/null 2>&1
done

# 1b) reorder so WORKING panes lead: busy (running an agent) first, grouped by
# project, idle shells pushed to the back. Step 2 then slices in this order, so the
# front tab(s) — the visible grid — hold the sessions you're actually working in
# instead of whatever pane-id order survived the consolidate. swap-pane only moves
# panes (never kills), so running agents are safe.
sort_key() {   # emit "busy\tproject\tpane_id" per pane; busy 0=agent 1=shell
  tmux list-panes -t "$first" -F '#{pane_id}|#{pane_current_command}|#{@proj}|#{b:pane_current_path}' \
  | while IFS='|' read -r pid cmd proj base; do
      case "$cmd" in zsh|-zsh|bash|-bash|sh|login|fish) busy=1 ;; *) busy=0 ;; esac
      printf '%d\t%s\t%s\n' "$busy" "${proj:-$base}" "$pid"
    done | sort -t$'\t' -k1,1n -k2,2 -k3,3
}
desired=( $(sort_key | cut -f3) )
# selection sort into `desired`: positions <k are already final, so only pull from >=k
for ((k = 0; k < ${#desired[@]}; k++)); do
  cur=$(tmux list-panes -t "$first" -F '#{pane_id}' | sed -n "$((k + 1))p")
  want=${desired[$k]}
  [[ -z "$cur" || "$cur" == "$want" ]] && continue
  tmux swap-pane -d -s "$want" -t "$cur" 2>/dev/null
done

# 2) break the pool into groups of `per`
ids=( $(tmux list-panes -t "$first" -F '#{pane_id}') )
total=${#ids[@]}
i=$per
while (( i < total )); do
  win=$(tmux break-pane -d -P -F '#{window_id}' -s "${ids[$i]}")
  (( i++ )); c=1
  while (( c < per && i < total )); do
    tmux join-pane -d -s "${ids[$i]}" -t "$win" 2>/dev/null
    (( i++, c++ ))
  done
done

# 3) per window: even grid if idle, else just tile (no-kill)
for win in $(tmux list-windows -t "$sess" -F '#{window_id}'); do
  if is_idle "$win"; then even_grid "$win"; else tmux select-layout -t "$win" tiled >/dev/null 2>&1; fi
done

# 4) top tabs = generic F1, F2, ...  (project name lives in each pane's title)
n=1
for wid in $(tmux list-windows -t "$sess" -F '#{window_id}'); do
  tmux rename-window -t "$wid" "F$n"; (( n++ ))
  while read -r pid pp; do
    ~/.local/bin/farm-tabname "$pp" "$pid" 2>/dev/null
  done < <(tmux list-panes -t "$wid" -F '#{pane_id} #{pane_current_path}')
done
