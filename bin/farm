#!/usr/bin/env bash
# farm [session] [total] [per] [dir] — build or attach ONE pool of `total` agent
# panes, grouped into tabs of `per`. Switch density live with small/big (which
# call farm-view) — panes are regrouped, never killed. Runs ON the Mac Studio.
#
#   session   tmux session name            (default: farm)
#   total     total agent panes in the pool (default: 8)
#   per       panes per tab to start with   (default: 8 = "big")
#   dir       starting dir for each pane     (default: ~/Projects)
#
# Re-running attaches the existing session instead of rebuilding.
set -uo pipefail

SESSION="${1:-farm}"
TOTAL="${2:-8}"
PER="${3:-8}"
START_DIR="${4:-$HOME/Projects}"

if tmux has-session -t "$SESSION" 2>/dev/null; then
  ~/.local/bin/farm-view "$PER" "$SESSION" "$START_DIR" >/dev/null 2>&1   # re-arrange existing pool to the requested per-tab
  exec tmux attach -t "$SESSION"
fi

tmux new-session -d -s "$SESSION" -x 400 -y 100 -c "$START_DIR" -n t1   # big virtual canvas so many panes fit during build
for ((i = 1; i < TOTAL; i++)); do
  tmux split-window -t "$SESSION:t1" -c "$START_DIR"
  tmux select-layout -t "$SESSION:t1" tiled >/dev/null
done
tmux set-option -t "$SESSION" @farm 1
~/.local/bin/farm-view "$PER" "$SESSION" "$START_DIR" >/dev/null 2>&1

tmux select-window -t "$SESSION:t1" 2>/dev/null || true
exec tmux attach -t "$SESSION"
