#!/usr/bin/env bash
set -euo pipefail

PROFILE="${1:-}"

load_machine_env() {
  # MCP clients launched from apps usually do not source shell profiles.
  # Source machine-local exports here; never store secrets in this repo.
  set -a
  for file in "$HOME/.profile" "$HOME/.zprofile"; do
    if [[ -r "$file" ]]; then
      # shellcheck source=/dev/null
      source "$file"
    fi
  done
  set +a
}

usage() {
  cat >&2 <<'USAGE'
Usage: agent-mcp <profile>

Profiles:
  chrome-devtools  Chrome DevTools MCP attached to the live Chrome session
  recall           Recall local MCP
  zapfeed          Zapfeed remote MCP via mcp-remote + ZAPFEED_API_KEY
  miro             Miro remote MCP via mcp-remote (OAuth browser login)
  slack            Slack remote MCP via mcp-remote (OAuth browser login)
  atlassian        Atlassian (Jira + Confluence) remote MCP via mcp-remote (OAuth browser login)
  guiport          macOS desktop automation MCP

Secrets stay machine-local. Put env exports in ~/.profile or ~/.zprofile.
USAGE
}

if [[ -z "$PROFILE" || "$PROFILE" == "-h" || "$PROFILE" == "--help" ]]; then
  usage
  exit 0
fi

case "$PROFILE" in
  chrome-devtools)
    exec npx -y chrome-devtools-mcp@latest --autoConnect
    ;;

  recall)
    exec /Applications/Recall.app/Contents/Resources/Runtime/bin/node \
      /Applications/Recall.app/Contents/Resources/Runtime/dist/mcp.js
    ;;

  zapfeed)
    load_machine_env
    if [[ -z "${ZAPFEED_API_KEY:-}" ]]; then
      echo "agent-mcp zapfeed: ZAPFEED_API_KEY missing. Set it in ~/.profile or ~/.zprofile." >&2
      exit 78
    fi
    export AUTH_HEADER="Bearer ${ZAPFEED_API_KEY}"
    # mcp-remote expands AUTH_HEADER itself; keep token out of process args.
    # shellcheck disable=SC2016
    exec npx -y mcp-remote@0.1.38 \
      https://zapfeed.io/api/mcp \
      --transport http-first \
      --header 'Authorization:${AUTH_HEADER}' \
      --silent
    ;;

  miro)
    # Remote HTTP MCP with OAuth 2.1 (dynamic client registration).
    # mcp-remote drives the browser login and caches tokens in ~/.mcp-auth.
    exec npx -y mcp-remote@latest \
      https://mcp.miro.com/ \
      --transport http-first
    ;;

  slack)
    # DO NOT use mcp-remote for Slack. The redacted Slack MCP app enforces a
    # fixed redirect-URI allowlist and rejects dynamic client registration.
    # mcp-remote's callback path is /oauth/callback on a random port, which is
    # never in the allowlist, so the browser login loops forever.
    #
    # Use a client with NATIVE remote-MCP OAuth instead (Claude Code, VS Code,
    # GitHub Copilot CLI). Native clients pin a fixed callback port and use the
    # /callback path, which the admin can allowlist. For Claude Code:
    #   claude mcp add --transport http \
    #     --client-id redacted --callback-port 8090 \
    #     -s user slack https://mcp.slack.com/mcp
    # then ask the Slack-app admin to allowlist http://localhost:8090/callback.
    echo "agent-mcp: 'slack' is not served via mcp-remote — use native" >&2
    echo "  Claude Code HTTP transport. See scripts/agent-mcp comments." >&2
    exit 64
    ;;

  atlassian)
    # Remote SSE MCP for Jira + Confluence. Atlassian supports dynamic client
    # registration, so mcp-remote's browser login works; tokens cached in
    # ~/.mcp-auth.
    exec npx -y mcp-remote@latest \
      https://mcp.atlassian.com/v1/sse
    ;;

  guiport)
    exec guiport serve --mcp
    ;;

  *)
    echo "agent-mcp: unknown profile '$PROFILE'" >&2
    usage
    exit 64
    ;;
esac
