#!/usr/bin/env bash
# Thin launcher so the CLI runs with uv-managed inline deps from anywhere.
# Symlink onto PATH:  ln -sf ~/Projects/agent/skills/apple-codesign/scripts/apple-codesign ~/Projects/agent/bin/apple-codesign
set -euo pipefail
# Resolve through symlinks (this script is symlinked onto PATH from bin/).
SRC="$0"
while [ -h "$SRC" ]; do
  DIR="$(cd -P "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  [ "${SRC#/}" = "$SRC" ] && SRC="$DIR/$SRC"
done
HERE="$(cd -P "$(dirname "$SRC")" && pwd)"
exec uv run --quiet "$HERE/apple_codesign.py" "$@"
